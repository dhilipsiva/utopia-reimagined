# ── Chapter 4 fidelity pins: "The Shield" ────────────────────────────────────
#
# KIND: CONTENT pin. Run:
#   nibli-pin --kb new-book-plans/constitution.nibli book-1/04-the-shield.pins.nibli

:expect-pins 21

# DON — "Don injured Pax. Then Don exposed Pax."
? injure(Don, Pax).
# => TRUE

? show(Don, Pax).
# => TRUE

# "Pax has none." — the condition that fails
? authority(Pax).
# => FALSE

# "Don has no shield and Don is a prisoner."
? defend(Don).
# => FALSE

? prisoner(Don).
# => TRUE

# SLY — "Sly injured Pax too. Then Sly exposed the court."
? injure(Sly, Pax).
# => TRUE

? show(Sly, Court).
# => TRUE

? authority(Court).
# => TRUE

# "So Sly's shield holds, and Sly ... walks free."
? defend(Sly).
# => TRUE

? prisoner(Sly).
# => FALSE

# KEL — "Then the review body examined the exposure and found it deceitful."
? show(Kel, Court).
# => TRUE

? deceive(Kel, Court).
# => TRUE

# "Kel's shield falls ... Kel is a prisoner ... Kel's own credibility is voided."
# KEL RESOLVES ONLY BECAUSE KEL EXPOSED ONCE. These three are per-subject and a
# per-subject pin cannot see a per-PAIR defect — the shield rule is satisfied by
# ANY qualifying pair, so a second exposure reopens it. That is what the Rex
# block below exists to hold, and why it is not enough to pin Kel.
? defend(Kel).
# => FALSE

? prisoner(Kel).
# => TRUE

? false(Kel).
# => TRUE

# REX — "Rex did what Kel did, and then did one more thing."
# The disclosed cost of scoping the shield to the exposure. If any of these six
# flip, chapter 4's "Rex" section and the second item in "What it costs" are
# both wrong, and so is the constitution's E1d commentary.
? show(Rex, Court).
# => TRUE

? deceive(Rex, Court).
# => TRUE

# "Rex's credibility was destroyed by the same counter-audit."
? false(Rex).
# => TRUE

# "Then Rex exposed the review body. Nobody has examined that one."
? show(Rex, Review).
# => TRUE

# THE PAIR THAT MATTERS. Voided and shielded at once — the finding against the
# first exposure has nothing to say about the second.
? defend(Rex).
# => TRUE

? prisoner(Rex).
# => FALSE
