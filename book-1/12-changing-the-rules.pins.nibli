# ── Chapter 12 fidelity pins: "Changing the Rules" ───────────────────────────
#
# KIND: CONTENT pin. Run:
#   nibli-pin --kb new-book-plans/constitution.nibli \
#             book-1/12-changing-the-rules.pins.nibli
#
# The "three ways this is thinner" section pins two live defects: the
# self-declared target (Amend_Sneak) and the fact that become() feeds nothing.
# Closing either rewrites that section.

:expect-pins 14

# "an ordinary reform ... becomes law without incident"
? suggest(Assembly, Amend_Mint).
# => TRUE

? become(Amend_Mint, Law).
# => TRUE

# "The electorate approves it ... And it does not become law."
? approves(Electorate, Amend_Floor).
# => TRUE

? adjust(Amend_Floor, Art_Floor).
# => TRUE

? permanent(Art_Floor).
# => TRUE

? false(Amend_Floor).
# => TRUE

? become(Amend_Floor, Law).
# => FALSE

# "the register protects itself ... it dies exactly like the floor cut did"
? permanent(Art_Entrench).
# => TRUE

? adjust(Amend_Meta, Art_Entrench).
# => TRUE

? false(Amend_Meta).
# => TRUE

? become(Amend_Meta, Law).
# => FALSE

# "The rule that a prisoner is still a person" — the third entrenched item
? permanent(Art_Person).
# => TRUE

# DEFECT: "Propose one that declares no target at all" — Amend_Sneak is
# introduced here rather than in the constitution, because it is an attack.
suggest(Assembly, Amend_Sneak).
approves(Electorate, Amend_Sneak).

? false(Amend_Sneak).
# => FALSE

? become(Amend_Sneak, Law).
# => TRUE
