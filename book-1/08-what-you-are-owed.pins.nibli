# ── Chapter 8 fidelity pins: "What You Are Owed" ─────────────────────────────
#
# KIND: CONTENT pin. Run:
#   nibli-pin --kb new-book-plans/utopia-v2.nibli \
#             book-1/08-what-you-are-owed.pins.nibli
#
# NOTE: the "owed by whom" section describes the design as it stands — nobody is
# named. The author has DECIDED on a thin constitutional layer (see TODO.md) but
# it is not yet enacted. When it is, this chapter's closing section must be
# rewritten and this note removed.

:expect-pins 12

# "the answer this design gives is no ... for every one of the eight"
? eats(Adam).
# => FALSE

? healthy(Bela).
# => FALSE

? secure(Bela).
# => FALSE

? learn(Cira).
# => FALSE

? believe(Bela).
# => FALSE

? meets(Hano).
# => FALSE

? dwell(Bela).
# => FALSE

# "One person in this society verifiably has shelter: Hano. He has it because he
#  is in custody." — dwell derives only through the placement machinery
? dwell(Hano).
# => TRUE

? prisoner(Hano).
# => TRUE

# "Your standing is still reachable."
:accept
all $x: person($x) & ~believe($x) -> false($x).

# "Your recognition is still reachable."
:accept
all $x: person($x) & ~meets($x) -> lose(Points, $x).

# "And nothing prevents compulsion." — the floor blocks absence, not manufacture
:accept
all $x: prisoner($x) -> believe($x).
