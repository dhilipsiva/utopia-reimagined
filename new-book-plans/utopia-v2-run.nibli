:load utopia.nibli
# --- Regression: every v0.1 pin must hold unchanged ---
:proof-verbose false(Bela).
:proof-verbose false(Esa).
:proof-verbose reward(Dev).
:proof-verbose false(Mira).
:proof-verbose false(Lupo).
:proof-verbose prisoner(Ivo).
:proof-verbose prisoner(Hano).
:proof-verbose prisoner(Nia).
:proof-verbose prisoner(Jala).
:proof-verbose travel(Jala).
:proof-verbose expresses(Adam).
:proof-verbose defend(Rebel).
:proof-verbose prisoner(Rebel).
:proof-verbose false(Rebel).
:proof-verbose building(HighSec, Lalo).
:proof-verbose building(LowSec, Nando).
:proof-verbose dwell(Hano).
# --- E1: the shield is no longer self-service (Art 7) ---
# Don "exposes" his own victim; in v0.1 this granted immunity.
:proof-verbose defend(Don).
:proof-verbose prisoner(Don).
# Sly exposes a real authority, Review has not ruled: protected (disclosed fail-open window).
:proof-verbose defend(Sly).
:proof-verbose prisoner(Sly).
# Kel's exposure was adjudicated deceitful: shield falls, counter-audit voids him.
:proof-verbose defend(Kel).
:proof-verbose prisoner(Kel).
:proof-verbose false(Kel).
# --- E2: a voided auditor cannot co-sign the next epoch (Art 4 + Art 8) ---
:proof-verbose permits(Review, Vex).
:proof-verbose permits(Review, Wren).
:proof-verbose false(Vex).
:proof-verbose false(Tyr).
# Seating is permanent (so it stays exposable); only power is revocable.
:proof-verbose authority(Boss).
:proof-verbose permits(Review, Boss).
# --- E3: the farmhouse is closed, and bad placement is now queryable (Art 6) ---
:proof-verbose prisoner(Ruk).
:proof-verbose building(HighSec, Ruk).
:proof-verbose fit(Ruk, Homestay).
:proof-verbose err(Ruk, Placement).
:proof-verbose err(Hano, Placement).
:proof-verbose err(Lalo, Placement).
:proof-verbose dwell(Ruk).
# --- Art 9: the entrenchment register entrenches itself ---
:proof-verbose false(Amend_Floor).
:proof-verbose become(Amend_Floor, Law).
:proof-verbose become(Amend_Mint, Law).
:proof-verbose false(Amend_Meta).
:proof-verbose become(Amend_Meta, Law).
:contradictions

