? defend(Don).
# => FALSE
? prisoner(Don).
# => TRUE
? defend(Sly).
# => TRUE
? defend(Kel).
# => FALSE
? false(Kel).
# => TRUE
? permits(Review, Vex).
# => FALSE
? permits(Review, Wren).
# => TRUE
? false(Vex).
# => TRUE
? false(Tyr).
# => FALSE
? authority(Boss).
# => TRUE
? permits(Review, Boss).
# => FALSE
? prisoner(Ruk).
# => TRUE
? building(HighSec, Ruk).
# => TRUE
? fit(Ruk, Homestay).
