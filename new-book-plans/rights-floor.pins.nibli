? err(Ruk, Placement).
# => TRUE
? err(Hano, Placement).
# => FALSE
? dwell(Ruk).
# => TRUE
# --- Article 9 ---
? false(Amend_Floor).
# => TRUE
? become(Amend_Floor, Law).
# => FALSE
? become(Amend_Mint, Law).
# => TRUE
? false(Amend_Meta).
# => TRUE
? become(Amend_Meta, Law).
