# ── Constitution pins: utopia-v2.nibli ───────────────────────────────────────
#
# KIND: CONTENT pin. The fixture is the SUBJECT of these pins, so it is loaded
# rather than inlined — inlining it would make this file certify a copy, and the
# copy drifts. Contrast nibli's own pins/*.nibli, which are MECHANISM pins and
# inline their fixtures precisely because the fixture is not the subject.
#
# Run:
#   nibli-pin --kb new-book-plans/utopia-v2.nibli new-book-plans/rights-floor.pins.nibli
#
# Every verdict below was produced by the engine, never by hand.

:expect-pins 85
# --- v0.1 regression pins ---
? false(Bela).
# => TRUE
? false(Esa).
# => FALSE
? reward(Dev).
# => FALSE
? false(Mira).
# => FALSE
? false(Lupo).
# => TRUE
? prisoner(Ivo).
# => FALSE
? prisoner(Hano).
# => TRUE
? prisoner(Nia).
# => FALSE
? prisoner(Jala).
# => FALSE
? travel(Jala).
# => TRUE
? expresses(Adam).
# => TRUE
? defend(Rebel).
# => TRUE
? prisoner(Rebel).
# => FALSE
? false(Rebel).
# => FALSE
? building(HighSec, Lalo).
# => TRUE
? building(LowSec, Nando).
# => TRUE
? dwell(Hano).
# => TRUE
