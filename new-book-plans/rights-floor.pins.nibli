# ── Constitution pins: utopia-v2.nibli ───────────────────────────────────────
#
# KIND: CONTENT pin. The fixture is the SUBJECT of these pins, so it is loaded
# rather than inlined — inlining it would make this file certify a copy, and the
# copy drifts. Contrast nibli's own pins/*.nibli, which are MECHANISM pins and
# inline their fixtures precisely because the fixture is not the subject.
#
# Run:
#   nibli-pin --kb new-book-plans/utopia-v2.nibli new-book-plans/rights-floor.pins.nibli
#
# Every verdict below was produced by the engine, never by hand.

:expect-pins 68
# --- v0.1 regression pins ---
? false(Bela).
# => TRUE
? false(Esa).
# => FALSE
? reward(Dev).
# => FALSE
? false(Mira).
# => FALSE
? false(Lupo).
# => TRUE
? prisoner(Ivo).
# => FALSE
? prisoner(Hano).
# => TRUE
? prisoner(Nia).
# => FALSE
? prisoner(Jala).
# => FALSE
? travel(Jala).
# => TRUE
? expresses(Adam).
# => TRUE
? defend(Rebel).
# => TRUE
? prisoner(Rebel).
# => FALSE
? false(Rebel).
# => FALSE
? building(HighSec, Lalo).
# => TRUE
? building(LowSec, Nando).
# => TRUE
? dwell(Hano).
# => TRUE
# --- E1/E2/E3 closures ---
? defend(Don).
# => FALSE
? prisoner(Don).
# => TRUE
? defend(Sly).
# => TRUE
? defend(Kel).
# => FALSE
? false(Kel).
# => TRUE
? permits(Review, Vex).
# => FALSE
? permits(Review, Wren).
# => TRUE
? false(Vex).
# => TRUE
? false(Tyr).
# => FALSE
? authority(Boss).
# => TRUE
? permits(Review, Boss).
# => FALSE
? prisoner(Ruk).
# => TRUE
? building(HighSec, Ruk).
# => TRUE
? fit(Ruk, Homestay).
# => FALSE
? err(Ruk, Placement).
# => TRUE
? err(Hano, Placement).
# => FALSE
? dwell(Ruk).
# => TRUE
# --- Article 9 ---
? false(Amend_Floor).
# => TRUE
? become(Amend_Floor, Law).
# => FALSE
? become(Amend_Mint, Law).
# => TRUE
? false(Amend_Meta).
# => TRUE
? become(Amend_Meta, Law).
# => FALSE
# --- fidelity table ---
? person(Hano).
# => TRUE
? expresses(Hano).
# => TRUE
? travel(Hano).
# => FALSE
? travel(Adam).
# => FALSE
? eats(Adam).
# => FALSE
? healthy(Bela).
# => FALSE
? secure(Bela).
# => FALSE
? learn(Cira).
# => FALSE
? believe(Bela).
# => FALSE
# --- v0.3 additions ---
? decide(Hano, Ballot).
# => TRUE
? decide(Jala, Ballot).
# => TRUE
? err(Hano, Isolation).
# => TRUE

# ── FIREWALL: no rule may punish the absence of a floor right ────────────────
:refuse reasoning /'prisoner' -> 'believe'/
all $x: person($x) & ~believe($x) -> prisoner($x).

:refuse reasoning /'prisoner' -> 'meets'/
all $x: person($x) & ~meets($x) -> prisoner($x).

:refuse reasoning /'prisoner' -> 'eats'/
all $x: person($x) & ~eats($x) -> prisoner($x).

:refuse reasoning /'prisoner' -> 'secure'/
all $x: person($x) & ~secure($x) -> prisoner($x).

# ── COMPLEMENT CONTROLS: the protected set is EXACTLY the floor ──────────────
# Refusals alone are satisfiable by an engine that refuses everything, and an
# over-broad protected set silently converts an ordinary predicate into an
# unconditional right. Each MUST still load.
:accept
all $x: person($x) & ~home($x) -> prisoner($x).

:accept
all $x: person($x) & ~choose($x) -> prisoner($x).

:accept
all $x: person($x) & ~permits($x) -> prisoner($x).

:accept
all $x: person($x) & ~false($x) -> prisoner($x).

# NOT a control, deliberately: ~travel is refused too, but for a reason unrelated
# to the floor — Article 2 derives travel behind ~prisoner, so it closes its own
# negative cycle. Listing it would pass for the wrong reason and keep passing
# after the firewall broke.

# ── ARTICLE 0: closed relations refuse direct assertion ──────────────────────
:refuse reasoning /declared derived-only/
fit(Ruk, Homestay).

:refuse reasoning /declared derived-only/
err(Hano, Placement).

:refuse reasoning /declared derived-only/
false(Ara).

# The two worst exploits, dead. Each was one asserted fact from bypassing the
# article that exists to prevent it; each is now refused at assert time.
:refuse reasoning /declared derived-only/
authority(Pax).

:refuse reasoning /declared derived-only/
permits(Review, Sock).

:refuse reasoning /declared derived-only/
prisoner(Zed).

# The complement half: closing a relation must not break its derivation, or the
# guarantee is just a ban. Each of these still derives from its new asserted
# source — public(Court), clear(Nia), and Article 6's conviction rule.
? authority(Court).
# => TRUE

? permits(Appeals, Nia).
# => TRUE

? prisoner(Adam).
# => TRUE
